# Local simulated banking runtime
BANKING_STORAGE=postgres
DATABASE_URL=postgresql://banking:banking@localhost:5432/banking_test
# P0 relational-v2 pool settings; keep aggregate pool max within PostgreSQL budget.
DB_POOL_MAX=4
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
DB_APPLICATION_NAME=banking-reference-backend

# Transactional outbox worker (opt-in; keep WORKER_ENABLED=0 until the HTTP
# persistence cutover removes the legacy full-state writer).
WORKER_ENABLED=0
WORKER_ID=worker-local
BANKING_PERSISTENCE_MODE=legacy-state
WORKER_ALLOW_LEGACY_WRITER=0
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_SHUTDOWN_TIMEOUT_MS=25000
WORKER_HEALTH_PORT=9091
PUSH_PROVIDER=disabled
EMAIL_PROVIDER=disabled
# Required only when starting the worker. This is a local placeholder, not a
# production secret and must be replaced by a secret manager in deployment.
NOTIFICATION_ENDPOINT_ENCRYPTION_KEY=local-only-change-me
# Optional: point this at a disposable database when running npm run test:relational.
# RELATIONAL_DATABASE_URL=postgresql://banking:banking@localhost:5432/banking_relational_test
# P0 foundation tests use a separate disposable database in CI.
# P0_RELATIONAL_DATABASE_URL=postgresql://banking:banking@localhost:5432/banking_p0_test
# Worker integration tests use a third disposable database in CI.
# WORKER_DATABASE_URL=postgresql://banking:banking@localhost:5432/banking_worker_test
PORT=5000
BANKING_ENV=development
NODE_ENV=development
BANKING_MFA_REQUIRED=1
BANKING_MFA_METHODS=OTP
BANKING_SANDBOX_MFA_OTP=654321
BANKING_SANDBOX_OTP=123456
BANKING_SETTLE_IMMEDIATELY=1
BUILD_COMMIT_SHA=local
# Local can use *; preview must use a comma-separated HTTPS origin allow-list.
BANKING_ALLOWED_ORIGINS=*
# For fast unit/reference runs only, set BANKING_STORAGE=in-memory explicitly.
# Operator-only key for local Sandbox Funding/OTP inspection; never expose it to Mobile.
BANKING_SANDBOX_OPERATOR_KEY=sandbox-operator-local
# Set to 1 only to seed a newly-created Credit statement as overdue for the
# dedicated notification/deep-link sandbox flow. Keep 0 for normal demos.
BANKING_SANDBOX_CREDIT_OVERDUE=0

# Persistent sandbox mode; use only with a disposable PostgreSQL database.
# DATABASE_URL=postgresql://banking:banking@localhost:5432/banking_test
# BANKING_STORAGE=postgres
# BANKING_SNAPSHOT_KEY=banking-reference-sandbox

# Preview safety: OTP MFA is required when BANKING_ENV=preview.
# BANKING_ENV=preview
# BANKING_MFA_REQUIRED=1
# BANKING_SANDBOX_MFA_OTP=<sandbox-mfa-secret>
# BANKING_SANDBOX_OTP=<sandbox-transfer-secret>
