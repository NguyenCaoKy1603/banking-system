# Local simulated banking runtime
BANKING_STORAGE=postgres
DATABASE_URL=postgresql://banking:banking@localhost:5432/banking_test
# Local development explicitly disables TLS; staging/production-like must use
# verify-full with a trusted CA and the exact PostgreSQL server hostname.
DATABASE_SSL_MODE=disable
# DATABASE_SERVER_NAME=postgres.staging.example.com
# DATABASE_CA_CERT=<CA certificate supplied by the trust store/SecretProvider>
# P0 relational-v2 pool settings; keep aggregate pool max within PostgreSQL budget.
DB_POOL_MAX=4
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
DB_APPLICATION_NAME=banking-reference-backend

# Transactional outbox worker (opt-in; keep WORKER_ENABLED=0 until the HTTP
# persistence cutover removes the legacy full-state writer).
WORKER_ENABLED=0
WORKER_ID=worker-local
BANKING_PERSISTENCE_MODE=legacy-state
WORKER_CUTOVER_CONFIRMED=0
WORKER_ALLOW_LEGACY_WRITER=0
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_SHUTDOWN_TIMEOUT_MS=25000
WORKER_HEALTH_PORT=9091
SCHEDULED_LIFECYCLE_ENABLED=0
SCHEDULED_LIFECYCLE_POLL_INTERVAL_MS=30000
SCHEDULED_LIFECYCLE_BATCH_SIZE=50
SCHEDULED_LIFECYCLE_STALL_THRESHOLD_MS=90000
PUSH_PROVIDER=disabled
# This controls the API registration OTP adapter. The outbox notification
# adapter may be selected independently with OUTBOX_EMAIL_PROVIDER.
EMAIL_PROVIDER=disabled
# EMAIL_PROVIDER_URL=http://127.0.0.1:8025/api/messages
# For a small Gmail SMTP rehearsal, use a dedicated sender account. The
# existing email-provider-token secret is the Gmail App Password in smtp mode.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=banking.demo@gmail.com
# SMTP_FROM=banking.demo@gmail.com
# EMAIL_PROVIDER_TOKEN=t
EMAIL_PROVIDER_TIMEOUT_MS=5000
EMAIL_PROVIDER_MAX_ATTEMPTS=3
EMAIL_PROVIDER_RETRY_DELAY_MS=100
# Admin bootstrap uses a distinct invitation gateway contract; the token is
# sent only over HTTPS and is never written to this file in staging.
# ADMIN_INVITATION_PROVIDER_URL=http://127.0.0.1:8025/invitations
# ADMIN_INVITATION_PROVIDER_TOKEN=<local-capture-bearer-optional>
# ADMIN_INVITATION_PROVIDER_TIMEOUT_MS=5000
# ADMIN_INVITATION_PROVIDER_MAX_ATTEMPTS=3
# ADMIN_INVITATION_PROVIDER_RETRY_DELAY_MS=100
# ADMIN_INVITATION_ALLOWED_DOMAINS=example.test
# ADMIN_INVITATION_ACTIVATION_URL=http://127.0.0.1:5173/admin/activate
OUTBOX_EMAIL_PROVIDER=disabled
# Required only when starting the worker. This is a local placeholder, not a
# production secret and must be replaced by a secret manager in deployment.
NOTIFICATION_ENDPOINT_ENCRYPTION_KEY=local-only-change-me
NOTIFICATION_ENDPOINT_ENCRYPTION_KEY_ID=endpoint-v1
# During rotation, keep the old value/key ID decrypt-only until re-encryption completes.
# NOTIFICATION_ENDPOINT_ENCRYPTION_KEY_PREVIOUS=<old-local-key>
# NOTIFICATION_ENDPOINT_ENCRYPTION_KEY_PREVIOUS_ID=endpoint-v0
# PostgreSQL destructive tests require a maintenance connection to postgres or
# template1. The runner creates banking_test_<pid>_<random>, migrates it, runs
# one suite and drops it. Never put the preview URL here and never load
# .env.compose for tests.
# DATABASE_TEST_ADMIN_URL=postgresql://banking:banking@localhost:5432/postgres
# NODE_ENV=test
# BANKING_ENV=test
# ALLOW_DATABASE_TEST_RESET=1
# DATABASE_TEST_ALLOWED_HOSTS=localhost,127.0.0.1,::1,postgres
PORT=5000
ADMIN_PORT=5001
ADMIN_BIND=127.0.0.1
ADMIN_STORAGE=postgres
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ADMIN_SECURE_COOKIES=0
BANKING_ENV=development
NODE_ENV=development
BANKING_MONEY_MODE=virtual
BANKING_SECRET_PROVIDER=local
# Staging/production-like require relational-v2; local remains explicit until
# every HTTP command is cut over from the legacy full-state adapter.
# BANKING_MANAGED_SECRETS_DIR=/run/secrets/banking
BANKING_MFA_REQUIRED=1
BANKING_MFA_METHODS=TOTP
# MFA secrets are required outside the in-memory test harness. Generate them
# with a secret manager; never commit their values or expose them to Mobile.
# BANKING_OTP_PEPPER=base64:<32-byte-secret>
# BANKING_OTP_PEPPER_KEY_ID=otp-v1
# BANKING_OTP_PEPPER_PREVIOUS=base64:<old-32-byte-secret>
# BANKING_OTP_PEPPER_PREVIOUS_KEY_ID=otp-v0
# BANKING_MFA_ENCRYPTION_KEY=base64:<32-byte-secret>
# BANKING_MFA_ENCRYPTION_KEY_ID=mfa-v1
# Recovery cooldown is intentionally long by default; set only in an isolated
# test database when exercising the completion path.
# BANKING_MFA_RECOVERY_COOLDOWN_MS=86400000
BANKING_SETTLE_IMMEDIATELY=1
BUILD_COMMIT_SHA=local
RELEASE_ID=local
IMAGE_DIGEST=unknown
BUILD_CREATED_AT=unknown
API_CONTRACT_DIGEST=unknown
# Local can use *; preview must use a comma-separated HTTPS origin allow-list.
BANKING_ALLOWED_ORIGINS=*
# For fast unit/reference runs only, set BANKING_STORAGE=in-memory explicitly.
# Set to 1 only to seed a newly-created Credit statement as overdue for the
# dedicated notification/deep-link sandbox flow. Keep 0 for normal demos.
BANKING_SANDBOX_CREDIT_OVERDUE=0

# Persistent sandbox mode; use only with a disposable PostgreSQL database.
# DATABASE_URL=postgresql://banking:banking@localhost:5432/banking_test
# BANKING_STORAGE=postgres
# BANKING_SNAPSHOT_KEY=banking-reference-sandbox

# Preview safety: TOTP MFA is required when BANKING_ENV=preview.
# BANKING_ENV=preview
# BANKING_MFA_REQUIRED=1
# BANKING_OTP_PEPPER=base64:<secret-manager-value>
# BANKING_MFA_ENCRYPTION_KEY=base64:<secret-manager-value>
