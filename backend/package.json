{
  "name": "banking-reference-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import=tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import=tsx src/server.ts",
    "admin:dev": "node --env-file-if-exists=.env --import=tsx src/adminServer.ts",
    "start:admin": "node dist/adminServer.js",
    "admin:bootstrap": "node --env-file-if-exists=.env --import=tsx scripts/admin-bootstrap.ts",
    "start:persistent": "npm run db:migrate && npm start",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "validate:database": "node --env-file-if-exists=.env scripts/validate-database-schema.cjs",
    "validate:outbox": "node --env-file-if-exists=.env scripts/validate-outbox-worker.cjs",
    "validate:relational-v2": "node --env-file-if-exists=.env scripts/validate-relational-v2.cjs",
    "p0:inventory": "node --env-file-if-exists=.env scripts/p0-inventory.cjs",
    "release:gate": "node scripts/release-gate.cjs",
    "release:migration-fingerprint": "node scripts/migration-fingerprint.cjs",
    "release:manifest": "node scripts/create-release-manifest.cjs",
    "release:verify-manifest": "node scripts/verify-release-manifest.cjs",
    "validate:secrets": "node scripts/validate-secret-surface.cjs",
    "validate:secret-registry": "node scripts/validate-secret-registry.cjs",
    "validate:image-surface": "node scripts/validate-image-surface.cjs",
    "backup:encrypt": "node scripts/encrypted-backup.cjs --encrypt",
    "backup:decrypt": "node scripts/encrypted-backup.cjs --decrypt",
    "backup:create": "node scripts/backup-create.cjs",
    "backup:verify": "node scripts/backup-verify.cjs",
    "backup:restore": "node scripts/restore-rehearsal.cjs",
    "backup:retention": "node scripts/backup-retention.cjs",
    "backup:validate": "node scripts/validate-backup-surface.cjs",
    "backup:pitr:check": "node scripts/pitr-drill.cjs",
    "backup:schedule": "node scripts/backup-scheduler.cjs",
    "backup:marker": "node scripts/dr-recovery-marker.cjs",
    "secrets:reencrypt": "node --import=tsx scripts/reencrypt-ciphertexts.ts",
    "validate:openapi": "node scripts/validate-openapi.cjs",
    "validate:admin-schema": "node --env-file-if-exists=.env scripts/validate-admin-schema.cjs",
    "validate:admin-authz": "node --env-file-if-exists=.env --import=tsx scripts/validate-admin-authz.ts",
    "validate:admin-openapi": "node scripts/validate-admin-openapi.cjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/apply-migration.cjs",
    "start:runtime": "node dist/server.js",
    "worker:dev": "node --env-file-if-exists=.env --import=tsx --watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "test:worker": "node --import=tsx scripts/run-disposable-postgres-test.ts src/tests/workerOutbox.test.ts",
    "test:worker:load": "node scripts/run-worker-load-test.cjs",
    "outbox:inspect": "node --env-file-if-exists=.env scripts/outbox-inspect.cjs",
    "outbox:inventory": "node --env-file-if-exists=.env scripts/outbox-inventory.cjs",
    "test:container-smoke": "node scripts/container-smoke.cjs",
    "reset:sandbox": "node --env-file-if-exists=.env --import=tsx scripts/reset-sandbox.ts",
    "test": "node scripts/run-core-tests.cjs",
    "test:critical": "tsx --test src/tests/http.test.ts",
    "test:observability": "tsx --test src/tests/observability.test.ts",
    "test:mfa": "tsx --test src/tests/mfa*.test.ts",
    "test:admin": "tsx --test src/tests/admin*.test.ts",
    "test:admin:e2e": "tsx --test src/tests/adminHttp.e2e.test.ts src/tests/adminP0.e2e.test.ts",
    "test:admin:database": "node --import=tsx scripts/run-disposable-postgres-test.ts src/tests/admin.database.test.ts",
    "test:admin:concurrency": "tsx --test src/tests/admin.concurrency*.test.ts",
    "test:relational": "node --import=tsx scripts/run-disposable-postgres-test.ts src/tests/relationalPersistence.test.ts",
    "test:persistence": "node --import=tsx scripts/run-disposable-postgres-test.ts src/tests/persistence.test.ts",
    "test:mfa:persistence": "node --import=tsx scripts/run-disposable-postgres-test.ts src/tests/mfaPersistence.test.ts",
    "test:savings:persistence": "node --import=tsx scripts/run-disposable-postgres-test.ts src/tests/savingsRelational.test.ts",
    "test:credit:persistence": "node --import=tsx scripts/run-disposable-postgres-test.ts src/tests/creditRelational.test.ts",
    "test:database": "node --import=tsx scripts/run-disposable-postgres-test.ts src/tests/databaseFoundation.test.ts",
    "test:database:guard": "tsx --test src/tests/disposableDatabaseGuard.test.ts",
    "seed:e2e": "node --env-file-if-exists=.env --import=tsx scripts/seed-e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "otpauth": "^9.5.1",
    "pg": "^8.23.0"
  }
}
