{
  "name": "banking-reference-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import=tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import=tsx src/server.ts",
    "start:persistent": "npm run db:migrate && npm start",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "validate:database": "node --env-file-if-exists=.env scripts/validate-database-schema.cjs",
    "validate:openapi": "node scripts/validate-openapi.cjs",
    "db:migrate": "node --env-file-if-exists=.env --import=tsx scripts/apply-migration.ts",
    "sandbox:fund": "node --env-file-if-exists=.env --import=tsx scripts/sandbox-fund.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "test:critical": "tsx --test src/tests/http.test.ts",
    "test:relational": "tsx --test src/tests/relationalPersistence.test.ts",
    "seed:e2e": "node --env-file-if-exists=.env --import=tsx scripts/seed-e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
