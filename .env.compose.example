# Copy to .env.compose for local preview only. Never commit the copied file.
POSTGRES_USER=banking
POSTGRES_PASSWORD=change-this-local-preview-password
POSTGRES_DB=banking_preview
DATABASE_URL=postgresql://banking:change-this-local-preview-password@postgres:5432/banking_preview
DATABASE_SSL_MODE=disable
POSTGRES_PORT=5433
BACKEND_PORT=5000
ADMIN_API_PORT=5001
ADMIN_BIND=0.0.0.0
ADMIN_WEB_PORT=5173
# Admin Web runtime proxy configuration (not a secret; never a VITE_* build arg).
ADMIN_WEB_ENV=preview
ADMIN_API_UPSTREAM=http://admin-api:5001
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ADMIN_SECURE_COOKIES=0
COMMIT_SHA=local
RELEASE_ID=local
IMAGE_DIGEST=unknown
MIGRATION_SET_DIGEST=unknown
API_CONTRACT_DIGEST=unknown
BANKING_ENV=preview
NODE_ENV=preview
BANKING_MONEY_MODE=virtual
BANKING_SECRET_PROVIDER=local
# Local-only HMAC key used to fingerprint registration network addresses.
# Generate at least 32 random bytes and encode them as standard Base64.
REGISTRATION_FINGERPRINT_KEY=base64:<generate-32-byte-secret>
# The approved local cutover uses direct relational-v2 HTTP boundaries. The
# route list is optional in relational-v2 because runtime defaults to the
# complete approved set; keep it explicit for local rehearsal. This is still
# untrusted local preview and is not staging/production evidence.
BANKING_PERSISTENCE_MODE=relational-v2
BANKING_RELATIONAL_HTTP_ROUTES=auth,registration,mfa,accounts,beneficiaries,transfers,savings,credit,recipients,notifications,fraud,kyc
# Staging only: an external Secret Manager may mount this absolute directory.
# BANKING_MANAGED_SECRETS_DIR=/run/secrets/banking

# P0 relational-v2 pool budget (multiply pool max by backend instances).
DB_POOL_MAX=4
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
DB_APPLICATION_NAME=banking-reference-backend

# Worker is opt-in (`docker compose --profile worker up --scale worker=2`).
# Keep it disabled until the HTTP relational-v2 cutover is complete.
WORKER_ENABLED=0
WORKER_PERSISTENCE_MODE=relational-v2
WORKER_CUTOVER_CONFIRMED=0
WORKER_ALLOW_LEGACY_WRITER=0
WORKER_HEALTH_PORT=9091
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_SHUTDOWN_TIMEOUT_MS=25000
SCHEDULED_LIFECYCLE_ENABLED=0
SCHEDULED_LIFECYCLE_POLL_INTERVAL_MS=30000
SCHEDULED_LIFECYCLE_BATCH_SIZE=50
SCHEDULED_LIFECYCLE_STALL_THRESHOLD_MS=90000
NOTIFICATION_ENDPOINT_ENCRYPTION_KEY=change-this-local-only-endpoint-key
NOTIFICATION_ENDPOINT_ENCRYPTION_KEY_ID=endpoint-v1
# NOTIFICATION_ENDPOINT_ENCRYPTION_KEY_PREVIOUS=change-this-old-local-endpoint-key
# NOTIFICATION_ENDPOINT_ENCRYPTION_KEY_PREVIOUS_ID=endpoint-v0
PUSH_PROVIDER=fake
# Registration OTP delivery uses Gmail SMTP adapter.
# Real credentials must never appear in example files or version control.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your-email@gmail.com
SMTP_FROM=your-email@gmail.com
EMAIL_PROVIDER_TOKEN=<your-16-char-gmail-app-password>
OUTBOX_EMAIL_PROVIDER=fake
EMAIL_PROVIDER_TIMEOUT_MS=5000
EMAIL_PROVIDER_MAX_ATTEMPTS=2
EMAIL_PROVIDER_RETRY_DELAY_MS=250
# Customer guide assistant is off by default. For local Compose preview only,
# enable it explicitly and opt in to Docker's host gateway for native Ollama.
ASSISTANT_ENABLED=0
ASSISTANT_PROVIDER=ollama
ASSISTANT_MODEL=qwen3.5:4b
ASSISTANT_OLLAMA_BASE_URL=http://host.docker.internal:11434
ASSISTANT_ALLOW_DOCKER_HOST=0
ASSISTANT_PROVIDER_TIMEOUT_MS=25000
ASSISTANT_REQUEST_TIMEOUT_MS=30000
ASSISTANT_OLLAMA_NUM_PREDICT=530
# Optional local Admin bootstrap invitation capture. Staging must use an
# HTTPS gateway URL and managed email-provider-token instead.
# ADMIN_INVITATION_PROVIDER_URL=http://mailpit:8025/invitations
# ADMIN_INVITATION_ALLOWED_DOMAINS=example.test
# ADMIN_INVITATION_ACTIVATION_URL=http://127.0.0.1:5173/admin/activate
# ADMIN_INVITATION_PROVIDER_TIMEOUT_MS=5000
# ADMIN_INVITATION_PROVIDER_MAX_ATTEMPTS=3
# ADMIN_INVITATION_PROVIDER_RETRY_DELAY_MS=100

BANKING_MFA_REQUIRED=1
BANKING_MFA_METHODS=TOTP
BANKING_OTP_PEPPER=base64:<generate-32-byte-secret>
BANKING_OTP_PEPPER_KEY_ID=otp-v1
# BANKING_OTP_PEPPER_PREVIOUS=base64:<old-32-byte-secret>
# BANKING_OTP_PEPPER_PREVIOUS_KEY_ID=otp-v0
BANKING_MFA_ENCRYPTION_KEY=base64:<generate-32-byte-secret>
BANKING_MFA_ENCRYPTION_KEY_ID=mfa-v1
# BANKING_MFA_ENCRYPTION_KEY_PREVIOUS=base64:<old-32-byte-secret>
# BANKING_MFA_ENCRYPTION_KEY_PREVIOUS_ID=mfa-v0
BANKING_SETTLE_IMMEDIATELY=1
BANKING_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,https://preview.example.invalid
BANKING_SANDBOX_CREDIT_OVERDUE=0
