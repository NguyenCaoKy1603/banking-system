# Sao chép file này thành .env.compose để chạy diễn tập local. Tuyệt đối không commit file .env.compose đã điền mật khẩu.

# 1. Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=banking
POSTGRES_PASSWORD=change-this-local-preview-password
POSTGRES_DB=banking_preview
DATABASE_URL=postgresql://banking:change-this-local-preview-password@postgres:5432/banking_preview
POSTGRES_PORT=5433
BACKEND_PORT=5000

# 2. Kiến trúc lưu trữ (44 bảng quan hệ)
BANKING_PERSISTENCE_MODE=relational-v2

# 3. Khóa bảo mật & Mã hóa (Bắt buộc: chuỗi ngẫu nhiên >= 32 bytes dạng Base64)
REGISTRATION_FINGERPRINT_KEY=base64:
BANKING_OTP_PEPPER=base64:
BANKING_MFA_ENCRYPTION_KEY=base64:

# 4. Phân quyền CORS cho Web & Mobile App Expo
BANKING_ALLOWED_ORIGINS=https://preview.example.invalid,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# 5. Cấu hình gửi mã OTP qua Gmail SMTP (Không bắt buộc nếu chưa cần test gửi mail thật)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your-email@gmail.com
SMTP_FROM=your-email@gmail.com
EMAIL_PROVIDER_TOKEN=<your-16-char-gmail-app-password>

# 6. Nghiệp vụ ngân hàng & Background Worker
BANKING_SETTLE_IMMEDIATELY=0
WORKER_ENABLED=1
WORKER_PERSISTENCE_MODE=relational-v2
WORKER_CUTOVER_CONFIRMED=1
SCHEDULED_LIFECYCLE_ENABLED=1
