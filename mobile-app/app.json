{
  "expo": {
    "name": "NOVA Banking",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.example.digitalbanking.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#155EEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép ứng dụng dùng Face ID để xác thực giao dịch."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép ứng dụng dùng camera để quét mã QR."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "runtimeEnvironment": "staging",
      "router": {},
      "eas": {
        "projectId": "6219b2dc-859c-4042-b68b-5cfd093d5d10"
      }
    },
    "owner": "nguyencaoky"
  }
}
