{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "local-sandbox",
        "EXPO_PUBLIC_SANDBOX_HTTP": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "local-sandbox",
        "EXPO_PUBLIC_SANDBOX_HTTP": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "staging",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_SANDBOX_HTTP": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_SANDBOX_HTTP": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
