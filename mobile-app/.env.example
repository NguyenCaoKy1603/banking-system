# Local sandbox only. Copy this file to .env for local emulator/Web use.
APP_VARIANT=local-sandbox
EXPO_PUBLIC_SANDBOX_HTTP=1

# Android emulator host alias; the app maps this alias to localhost on Web.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

# Staging/production EAS profiles set APP_VARIANT and disable the sandbox flag.
# Supply an HTTPS URL in the selected deployment environment.
# EXPO_PUBLIC_API_URL=https://api.example.invalid/api/v1
